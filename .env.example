# Public Supabase browser/server connection values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Origin used to build auth email links (verification, password reset).
# Must also be listed in the Supabase project's redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Log level for lib/logging.ts: debug | info | warn | error.
# Defaults to debug in development and info in production.
NEXT_PUBLIC_LOG_LEVEL=debug

# Hosts used by test fixtures. Both default to .invalid domains, so tests
# never reach a real host; set them only to point fixtures somewhere else.
TEST_MEDIA_HOST=https://storage.test.invalid
TEST_EXTERNAL_HOST=https://example.invalid
